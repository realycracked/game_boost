<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo FileDrop : une flèche ascendante qui « émet » trois ondes de diffusion.
  L'idée (diffusion vers les appareils proches) est volontairement proche de ce
  que le concept évoque, mais le tracé, les proportions et la palette sont
  originaux : arcs à 90°, flèche pleine, dégradé turquoise → bleu.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Onde extérieure -->
    <path
        android:pathData="M25.72,49.72 A40,40 0 0 1 82.28,49.72"
        android:strokeColor="#00C6A7"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- Onde médiane -->
    <path
        android:pathData="M32.08,56.08 A31,31 0 0 1 75.92,56.08"
        android:strokeColor="#12A6E0"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- Onde intérieure -->
    <path
        android:pathData="M38.44,62.44 A22,22 0 0 1 69.56,62.44"
        android:strokeColor="#1E6FFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- Flèche d'envoi -->
    <path
        android:pathData="M54,66 L64,77 L58,77 L58,88 L50,88 L50,77 L44,77 Z"
        android:fillColor="#1E6FFF" />
</vector>
